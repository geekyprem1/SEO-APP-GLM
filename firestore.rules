rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A user owns their profile doc but may only ever write the exact fields
    // allowlisted below. Everything else — plan, status, lifetime, admin,
    // role, isPro, uid, email, isAnonymous, createdAt — is server-only, so a
    // client can never grant itself entitlements or spoof identity fields.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Fields the client may set when creating its own profile document.
      function creatableFields() {
        return ['uid', 'email', 'displayName', 'photoUrl', 'isAnonymous',
                'plan', 'createdAt', 'lastSeen'];
      }

      // Fields the client may change after creation.
      function updatableFields() {
        return ['displayName', 'photoUrl', 'lastSeen'];
      }

      // Create: only a clean free profile with a matching uid, no unknown keys.
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(creatableFields())
                    && request.resource.data.uid == userId
                    && request.resource.data.plan == 'free'
                    && !('status' in request.resource.data)
                    && !('lifetime' in request.resource.data);

      // Update: only the allowlisted mutable fields may differ.
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(updatableFields());

      allow delete: if false; // deletion happens via deleteMyAccount Cloud Function

      // Usage counters are written ONLY by Cloud Functions (Admin SDK).
      // The client may read its own usage but never write it (anti quota-reset).
      match /usage/{dateKey} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Any other subcollection: owner-readable, server-write only.
      match /{subColl}/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Everything else (admin collections, logs, cache, config, subscriptions,
    // adminLogs, etc.) is server-only. Clients are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
